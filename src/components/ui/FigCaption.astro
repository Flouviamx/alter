---
// Pie de foto editorial: "Fig. n · título". vertical = corre junto al borde derecho de la foto.
// El padre debe tener position: relative (o absolute) para la variante vertical.
interface Props {
  n?: number;
  title: string;
  vertical?: boolean;
  class?: string;
}

const { n, title, vertical = false, class: className } = Astro.props;
---

<p class:list={['fig', { 'fig--vertical': vertical }, className]} data-reveal>
  {n !== undefined && <span class="fig__n display">Fig. {n}</span>}
  {title}
</p>

<style>
  .fig {
    margin-top: 0.55rem;
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    line-height: 1.4;
    color: var(--tinta-soft);
  }

  /* Margen lógico: funciona igual en horizontal y en vertical */
  .fig__n {
    margin-inline-end: 0.35rem;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    color: var(--terracota);
  }

  .fig--vertical {
    position: absolute;
    top: 0;
    left: 100%;
    margin: 0 0 0 0.6rem;
    writing-mode: vertical-rl;
    white-space: nowrap;
  }
</style>
