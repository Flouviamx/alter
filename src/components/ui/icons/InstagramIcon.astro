---
interface Props {
  size?: number;
}

const { size = 18 } = Astro.props;
---

<svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" class="icon">
  <rect x="3.25" y="3.25" width="17.5" height="17.5" rx="5" fill="none" stroke="currentColor" stroke-width="1.3"></rect>
  <circle cx="12" cy="12" r="4.1" fill="none" stroke="currentColor" stroke-width="1.3"></circle>
  <circle cx="17.3" cy="6.7" r="1" fill="currentColor"></circle>
</svg>

<style>
  .icon {
    flex-shrink: 0;
  }
</style>
