---
// Botón-enlace tipo píldora. variant: solid (tinta) | outline | light (sobre fondo oscuro)
interface Props {
  href: string;
  variant?: 'solid' | 'outline' | 'light';
  external?: boolean;
  class?: string;
}

const { href, variant = 'solid', external = false, class: className } = Astro.props;
const rel = external ? 'noopener noreferrer' : undefined;
const target = external ? '_blank' : undefined;
---

<a href={href} class:list={['btn', `btn--${variant}`, className]} rel={rel} target={target}>
  <slot />
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1rem 1.7rem;
    border-radius: 999px;
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    transition:
      background-color 0.4s var(--ease-out),
      color 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out);
  }

  .btn--solid {
    background: var(--tinta);
    color: var(--lino);
  }

  .btn--solid:hover {
    background: var(--terracota);
  }

  .btn--outline {
    box-shadow: inset 0 0 0 1px var(--tinta);
  }

  .btn--outline:hover {
    background: var(--tinta);
    color: var(--lino);
  }

  .btn--light {
    background: var(--lino);
    color: var(--tinta);
  }

  .btn--light:hover {
    background: var(--salvia);
  }
</style>
