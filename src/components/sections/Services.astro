---
// 03 — Servicios. Filas tipo índice (como el hero) con foto que sigue al cursor + flyer de precios en WebGL.
// Datos en src/data/services.ts.
import { Image } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import ArrowCircle from '../ui/ArrowCircle.astro';
import PriceFlyer from '../blocks/PriceFlyer.astro';
import { services } from '../../data/services';
import { byId } from '../../data/work';

const rows = services.map((service) => ({ ...service, piece: byId(service.preview) }));
---

<section class="services" id="servicios" aria-labelledby="servicios-title" data-section="03" data-section-label="Servicios">
  <div class="services__inner wrap">
    <div class="services__main" data-hover-root>
      <SectionHeading label="Servicios" title="Del boceto al último ajuste." id="servicios-title" />

      <ol class="services__list">
        {rows.map((row, i) => (
          <li class="services__row" data-reveal data-hover-row={i}>
            <span class="services__n">{row.n}</span>
            <div class="services__copy">
              <h3 class="services__title">{row.title}</h3>
              <p class="services__body">{row.body}</p>
            </div>
            <span class="services__arrow"><ArrowCircle /></span>
          </li>
        ))}
      </ol>

      <figure class="services__hover" aria-hidden="true" data-hover-figure>
        {rows.map((row, i) => (
          <Image src={row.piece.image} alt="" widths={[300, 500]} sizes="14rem" data-hover-img={i} loading="lazy" />
        ))}
      </figure>
    </div>

    <div class="services__aside">
      <PriceFlyer />
    </div>
  </div>
</section>

<style>
  .services {
    padding-block: var(--section-y);
  }

  .services__inner {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }

  .services__main {
    position: relative;
  }

  .services__list {
    margin-top: 2.4rem;
  }

  .services__row {
    display: grid;
    grid-template-columns: 2.6rem 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1.15rem 0;
    border-top: 1px solid var(--line);
    transition: color 0.4s var(--ease-out);
  }

  .services__row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .services__n {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--tinta-soft);
  }

  .services__title {
    font-size: 0.92rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .services__body {
    margin-top: 0.3rem;
    max-width: 46ch;
    font-size: 0.9rem;
    color: var(--tinta-soft);
  }

  .services__arrow {
    display: inline-flex;
    transition: transform 0.5s var(--ease-out);
  }

  .services__row:hover {
    color: var(--terracota);
  }

  .services__row:hover .services__arrow {
    transform: translateX(6px);
  }

  /* Foto flotante: posición y visibilidad las controla scripts/motion/hoverPreview.ts */
  .services__hover {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    width: 14rem;
    aspect-ratio: 3 / 4;
    margin: 0;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    box-shadow: 0 30px 60px -30px rgb(35 38 28 / 0.55);
  }

  .services__hover :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }

  @media (max-width: 960px) {
    .services__inner {
      grid-template-columns: 1fr;
    }

    .services__aside {
      max-width: 30rem;
    }
  }
</style>

<script>
  import { initHoverPreview } from '../../scripts/motion/hoverPreview';

  document.querySelectorAll<HTMLElement>('[data-hover-root]').forEach(initHoverPreview);
</script>
