---
// 04 — Servicios. Filas tipo índice (como el hero) + flyer de precios en WebGL.
// Datos en src/data/services.ts.
import SectionHeading from '../ui/SectionHeading.astro';
import ArrowCircle from '../ui/ArrowCircle.astro';
import PriceFlyer from '../blocks/PriceFlyer.astro';
import { services } from '../../data/services';
---

<section class="services" id="servicios" aria-labelledby="servicios-title" data-section="04" data-section-label="Servicios">
  <div class="services__inner wrap">
    <div class="services__main">
      <SectionHeading label="Servicios" />
      <h2 id="servicios-title" class="sr-only">Servicios</h2>

      <ol class="services__list">
        {services.map((row) => (
          <li class="services__row" data-reveal>
            <span class="services__n">{row.n}</span>
            <div class="services__copy">
              <h3 class="services__title">{row.title}</h3>
              <p class="services__body">{row.body}</p>
            </div>
            <span class="services__arrow"><ArrowCircle /></span>
          </li>
        ))}
      </ol>
    </div>

    <div class="services__aside">
      <PriceFlyer />
    </div>
  </div>
</section>

<style>
  .services {
    padding-block: var(--section-y);
    overflow-x: clip; /* el canvas del flyer sangra; sin esto hay scroll horizontal en móvil con reduced motion */
  }

  .services__inner {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }

  .services__list {
    margin-top: 2.4rem;
  }

  .services__row {
    display: grid;
    grid-template-columns: 2.6rem 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1.15rem 0;
    border-top: 1px solid var(--line);
    transition: color 0.4s var(--ease-out);
  }

  .services__row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .services__n {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--tinta-soft);
  }

  .services__title {
    font-size: 0.92rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .services__body {
    margin-top: 0.3rem;
    max-width: 46ch;
    font-size: 0.9rem;
    color: var(--tinta-soft);
  }

  .services__arrow {
    display: inline-flex;
    transition: transform 0.5s var(--ease-out);
  }

  .services__row:hover {
    color: var(--terracota);
  }

  .services__row:hover .services__arrow {
    transform: translateX(6px);
  }

  @media (max-width: 960px) {
    .services__inner {
      grid-template-columns: 1fr;
    }

    .services__aside {
      max-width: 30rem;
    }
  }
</style>
