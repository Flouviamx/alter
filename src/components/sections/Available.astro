---
// 03 — Piezas disponibles. Prendas terminadas a la venta, con la misma galería que Diseños
// (una tarjeta por modelo; sus colores y vistas se hojean en la tarjeta). Datos en src/data/work.ts.
// Copy en borrador: validar con la clienta (docs/pages/home.md).
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import WhatsAppIcon from '../ui/icons/WhatsAppIcon.astro';
import DesignGallery from '../islands/gallery/DesignGallery';
import { galleryGroups } from '../islands/gallery/groups';
import { whatsappLink } from '../../data/site';

const groups = await galleryGroups('disponibles');
const inquiry = whatsappLink('Hola Anter House, me interesa una de las piezas disponibles.');
---

<section class="available" id="disponibles" aria-labelledby="disponibles-title" data-section="03" data-section-label="Piezas disponibles">
  <div class="wrap">
    <div class="available__head">
      <SectionHeading label="Piezas disponibles" title="Listas para estrenar." id="disponibles-title" />
      <div class="available__aside" data-reveal>
        <p>Prendas terminadas en el taller. Pregunta por tallas y colores.</p>
        <Button href={inquiry} variant="outline" external><WhatsAppIcon size={15} /> Preguntar</Button>
      </div>
    </div>
    <div class="available__groups">
      <DesignGallery client:visible groups={groups} />
    </div>
  </div>
</section>

<style>
  .available {
    padding-block: var(--section-y);
  }

  .available__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .available__aside {
    display: grid;
    justify-items: start;
    gap: 1.1rem;
    max-width: 22rem;
  }

  .available__aside p {
    font-size: 0.9rem;
    color: var(--tinta-soft);
  }

  .available__groups {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
</style>
