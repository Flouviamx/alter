---
// 01 — Nuestra esencia. Maquetada como página de revista de moda:
// capital, cuerpo a dos columnas con entrada en versalitas, cita destacada y pies de foto.
// Copy en borrador: validar con la clienta (docs/pages/home.md).
import { Image } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import WordReveal from '../ui/WordReveal.astro';
import FigCaption from '../ui/FigCaption.astro';
import { byId } from '../../data/work';

const manifesto =
  'Cada pieza empieza con una conversación. Escuchamos qué quieres sentir el día que la uses y lo traducimos en tela, corte y detalle, construido alrededor de ti.';

// Collage: cada foto con su pie de foto editorial ("Fig. n · título").
const figures = [
  { piece: byId('novia-salon'), variant: 'portrait', parallax: '-0.06', widths: [500, 800, 1100], sizes: '(max-width: 860px) 60vw, 24vw' },
  { piece: byId('novia-detalle'), variant: 'detail', parallax: '-0.22', widths: [300, 600], sizes: '(max-width: 860px) 34vw, 12vw' },
  { piece: byId('novia-espejo'), variant: 'mirror', parallax: '-0.14', widths: [300, 600], sizes: '(max-width: 860px) 30vw, 11vw' },
];
---

<section class="essence" id="esencia" aria-labelledby="esencia-title" data-section="01" data-section-label="Nuestra esencia">
  <div class="essence__inner wrap">
    <div class="essence__text">
      <SectionHeading label="Nuestra esencia" />
      <h2 id="esencia-title" class="sr-only">Nuestra esencia</h2>

      <WordReveal text={manifesto} class="essence__manifesto display" dropCap />

      <p class="essence__body" data-reveal>
        <span class="essence__lead-in">Nada sale de un molde</span> genérico: tomamos tus medidas, elegimos juntas los
        materiales y probamos sobre el cuerpo hasta que la pieza cae perfecto. Cada vestido pasa por varias pruebas en el
        taller antes de llegar a ti, y se termina a mano, puntada por puntada.
      </p>

      <figure class="essence__quote" data-reveal>
        <blockquote class="display">Diseño propio, pruebas en taller y acabados a mano.</blockquote>
        <figcaption>Anter House, Monterrey</figcaption>
      </figure>
    </div>

    <div class="essence__collage">
      {figures.map(({ piece, variant, parallax, widths, sizes }, i) => (
        <div class:list={['essence__item', `essence__item--${variant}`]} data-parallax={parallax}>
          <figure class="essence__photo" data-clip>
            <Image src={piece.image} alt={piece.alt} widths={widths} sizes={sizes} />
          </figure>
          <FigCaption n={i + 1} title={piece.title} vertical={variant === 'portrait'} />
        </div>
      ))}
      <p class="essence__vertical display" aria-hidden="true" data-reveal>Monterrey, N.L.</p>
    </div>
  </div>
</section>

<style>
  .essence {
    padding-block: var(--section-y);
  }

  .essence__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }

  /* :global porque el <p> lo renderiza WordReveal (otro scope) */
  .essence__text :global(.essence__manifesto) {
    margin-top: 1.8rem;
    font-size: var(--text-lead);
    line-height: 1.22;
    max-width: 24ch;
  }

  /* Cuerpo a dos columnas con filete, como una página de revista */
  .essence__body {
    margin-top: 2rem;
    max-width: 38rem;
    columns: 2;
    column-gap: 2.2rem;
    column-rule: 1px solid var(--line);
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--tinta-soft);
  }

  .essence__lead-in {
    font-size: 0.78em;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tinta);
  }

  /* Cita destacada: filete vertical terracota, como un pull quote de revista */
  .essence__quote {
    margin: 2.6rem 0 0;
    padding-left: 1.4rem;
    max-width: 30rem;
    border-left: 1px solid var(--terracota);
  }

  .essence__quote blockquote {
    margin: 0;
    font-size: clamp(1.25rem, 1.7vw, 1.6rem);
    line-height: 1.2;
  }

  .essence__quote figcaption {
    margin-top: 0.9rem;
    font-size: 0.62rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--tinta-soft);
  }

  /* Collage: misma gramática que el hero (fotos sueltas a distintas escalas) */
  .essence__collage {
    position: relative;
    height: clamp(26rem, 46vw, 40rem);
  }

  .essence__item {
    position: absolute;
  }

  .essence__photo {
    margin: 0;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--salvia-soft);
  }

  .essence__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .essence__item--portrait {
    left: 18%;
    top: 4%;
    width: 50%;
  }

  .essence__item--detail {
    left: 0;
    bottom: 0;
    width: 26%;
  }

  .essence__item--mirror {
    right: 0;
    top: 30%;
    width: 24%;
  }

  .essence__vertical {
    position: absolute;
    right: 3%;
    top: 0;
    writing-mode: vertical-rl;
    font-size: 1.1rem;
    color: var(--terracota);
  }

  @media (max-width: 860px) {
    .essence__inner {
      grid-template-columns: 1fr;
    }

    .essence__collage {
      height: 118vw;
    }

    .essence__body {
      columns: 1;
    }
  }
</style>
