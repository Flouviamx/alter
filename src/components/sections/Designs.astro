---
// 02 — Diseños. Piezas agrupadas por categoría (Novias, Fiesta), cada grupo en una tira horizontal.
// Cada pieza es un vestido; si tiene varias fotos, se hojean en la misma tarjeta.
// Las imágenes se optimizan en el servidor y se pasan a la isla React (lightbox incluido).
import SectionHeading from '../ui/SectionHeading.astro';
import DesignGallery from '../islands/gallery/DesignGallery';
import { galleryGroups } from '../islands/gallery/groups';

const groups = await galleryGroups('disenos');
---

<section class="designs" id="disenos" aria-labelledby="disenos-title" data-section="02" data-section-label="Diseños">
  <div class="wrap">
    <SectionHeading label="Diseños" title="Piezas hechas una sola vez." id="disenos-title" />
    <div class="designs__groups">
      <DesignGallery client:visible groups={groups} />
    </div>
  </div>
</section>

<style>
  .designs {
    padding-block: var(--section-y);
  }

  .designs__groups {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
</style>
