---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Menu from '../components/layout/Menu.astro';
import SectionTicker from '../components/layout/SectionTicker.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import Essence from '../components/sections/Essence.astro';
import Process from '../components/sections/Process.astro';
import Designs from '../components/sections/Designs.astro';
import Available from '../components/sections/Available.astro';
import Services from '../components/sections/Services.astro';
import Appointment from '../components/sections/Appointment.astro';
---

<Layout>
  <Fragment slot="fixed">
    <Header />
    <Menu />
    <SectionTicker />
  </Fragment>

  <main>
    <Hero />
    <Essence />
    <Process />
    <Designs />
    <Available />
    <Services />
    <Appointment />
  </main>
  <Footer />
</Layout>
